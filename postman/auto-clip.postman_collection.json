          "raw": "{\n  \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n  \"start\": 5,\n  \"end\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/clip",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "clip"
